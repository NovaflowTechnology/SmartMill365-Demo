{
  "info": {
    "name": "SmartFactory365 - Password Reset OTP",
    "_postman_id": "sf365-password-reset-otp",
    "description": "Test collection for password reset OTP endpoints.\n\nBase URL variable: {{baseUrl}}\n\nLocal emulator:  http://127.0.0.1:5001/<your-project-id>/us-central1/api\nProduction:      https://api-ic7ypg6ukq-uc.a.run.app",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5001/smartmachine365/us-central1/api",
      "description": "Change to production URL when deploying"
    },
    {
      "key": "testUid",
      "value": "REPLACE_WITH_REAL_UID",
      "description": "Firebase Auth UID of the user to test with"
    },
    {
      "key": "testEmail",
      "value": "REPLACE_WITH_REAL_EMAIL",
      "description": "Email address of the test user"
    },
    {
      "key": "lastOtp",
      "value": "",
      "description": "Auto-filled by Send OTP test script (if OTP is returned in dev mode)"
    }
  ],
  "item": [
    {
      "name": "1. Send OTP",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has success true', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.be.true;",
              "  pm.expect(json.message).to.include('OTP');",
              "});",
              "",
              "pm.test('Response time under 5s', function () {",
              "  pm.expect(pm.response.responseTime).to.be.below(5000);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"uid\": \"{{testUid}}\",\n  \"email\": \"{{testEmail}}\",\n  \"userName\": \"Test User\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/password-reset/send-otp",
          "host": ["{{baseUrl}}"],
          "path": ["password-reset", "send-otp"]
        },
        "description": "Generates a 6-digit OTP, stores the SHA-256 hash in Firestore (otp_verifications/{uid}), and sends the OTP to the user's email.\n\nExpected: 200 { success: true, message: 'OTP sent to email.' }"
      }
    },
    {
      "name": "2. Verify OTP - Valid",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Password updated successfully', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.be.true;",
              "  pm.expect(json.message).to.include('Password updated');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"uid\": \"{{testUid}}\",\n  \"otp\": \"REPLACE_WITH_OTP_FROM_EMAIL\",\n  \"newPassword\": \"NewPass@12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/password-reset/verify-otp",
          "host": ["{{baseUrl}}"],
          "path": ["password-reset", "verify-otp"]
        },
        "description": "Verifies the OTP and updates the user's Firebase Auth password.\n\nSteps:\n1. Run 'Send OTP' first\n2. Check email for the 6-digit code\n3. Paste the code into the otp field here\n\nExpected: 200 { success: true, message: 'Password updated successfully.' }"
      }
    },
    {
      "name": "3. Verify OTP - Wrong Code",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401', function () {",
              "  pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test('Error message mentions Invalid OTP', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.error).to.include('Invalid OTP');",
              "});",
              "",
              "pm.test('attemptsRemaining is a number', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.attemptsRemaining).to.be.a('number');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"uid\": \"{{testUid}}\",\n  \"otp\": \"000000\",\n  \"newPassword\": \"NewPass@12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/password-reset/verify-otp",
          "host": ["{{baseUrl}}"],
          "path": ["password-reset", "verify-otp"]
        },
        "description": "Sends a deliberately wrong OTP (000000).\n\nExpected: 401 { error: 'Invalid OTP. X attempt(s) remaining.', attemptsRemaining: N }"
      }
    },
    {
      "name": "4. Verify OTP - Missing Fields",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 400', function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Error message present', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.error).to.be.a('string');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"uid\": \"{{testUid}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/password-reset/verify-otp",
          "host": ["{{baseUrl}}"],
          "path": ["password-reset", "verify-otp"]
        },
        "description": "Sends request with missing otp and newPassword fields.\n\nExpected: 400 { error: 'uid, otp, and newPassword are required.' }"
      }
    },
    {
      "name": "5. Verify OTP - Weak Password",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 400', function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Error mentions password length', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.error).to.include('6 characters');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"uid\": \"{{testUid}}\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"abc\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/password-reset/verify-otp",
          "host": ["{{baseUrl}}"],
          "path": ["password-reset", "verify-otp"]
        },
        "description": "Sends a password shorter than 6 characters.\n\nExpected: 400 { error: 'Password must be at least 6 characters.' }"
      }
    },
    {
      "name": "6. Resend OTP",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('New OTP sent', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.be.true;",
              "  pm.expect(json.message).to.include('OTP');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"uid\": \"{{testUid}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/password-reset/resend-otp",
          "host": ["{{baseUrl}}"],
          "path": ["password-reset", "resend-otp"]
        },
        "description": "Generates and sends a fresh OTP, resetting the attempts counter and expiry.\n\nRequires an existing otp_verifications/{uid} doc (run Send OTP first).\n\nExpected: 200 { success: true, message: 'New OTP sent.' }"
      }
    },
    {
      "name": "7. Resend OTP - No Pending Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 404', function () {",
              "  pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test('Error mentions no pending request', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.error).to.include('No pending OTP');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"uid\": \"non_existent_uid_12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/password-reset/resend-otp",
          "host": ["{{baseUrl}}"],
          "path": ["password-reset", "resend-otp"]
        },
        "description": "Tries to resend OTP for a UID that has no pending request.\n\nExpected: 404 { error: 'No pending OTP request found for this user.' }"
      }
    },
    {
      "name": "8. Send OTP - Missing UID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 400', function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Error mentions uid and email', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.error).to.include('uid');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"userName\": \"Test User\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/password-reset/send-otp",
          "host": ["{{baseUrl}}"],
          "path": ["password-reset", "send-otp"]
        },
        "description": "Sends request without uid field.\n\nExpected: 400 { error: 'uid and email are required.' }"
      }
    }
  ]
}
